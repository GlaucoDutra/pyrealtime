OPENAI_API_KEY=sk-your-server-key
APP_BASE_URL=http://localhost:8000
APP_API_KEY=replace-with-an-app-token
APP_CORS_ORIGINS=http://127.0.0.1:5173
PYREALTIME_MODEL=gpt-realtime-2.1-mini
PYREALTIME_VOICE=marin
PYREALTIME_INSTRUCTIONS=You are a concise and helpful realtime assistant.
PYREALTIME_REQUEST_TIMEOUT_SECONDS=20
PYREALTIME_TOOL_MODEL=gpt-5-mini
PYREALTIME_TOOL_TIMEOUT_SECONDS=120
PYREALTIME_IMAGE_MODEL=gpt-image-2.5-flare
PYREALTIME_VECTOR_STORE_IDS=
PYREALTIME_ALLOW_ANONYMOUS=false
PYREALTIME_MAX_SDP_BYTES=1000000
PYREALTIME_MAX_TOOL_REQUEST_BYTES=64000
PYREALTIME_SESSION_RATE_LIMIT=10
PYREALTIME_TOOL_RATE_LIMIT=60
PYREALTIME_FILE_RATE_LIMIT=10
PYREALTIME_RATE_LIMIT_WINDOW_SECONDS=60
PYREALTIME_REQUEST_ID_HEADER=X-Request-ID
PYREALTIME_JSON_LOGS=true
